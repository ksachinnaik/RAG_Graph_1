def clean_text(text):
    text = re.sub(r"<!\[CDATA\[|\]\]>", "", text)
    text = BeautifulSoup(text, "html.parser").get_text(" ")
    text = re.sub(r"\[\[.*?\]\]|\{\{.*?\}\}", "", text)
    return re.sub(r"\s+", " ", text).strip()

df_clean = df.rdd.map(lambda r: Row(
    doc_id=str(r["doc_id"]),
    content=clean_text(r["content"]),
    reference=r["reference"]
)).toDF()

display(df_clean)
