G = nx.DiGraph()

# Step 1: Add nodes
for r in rows:
    G.add_node(r["doc_id"], content=r["content"], reference=r["reference"])

# Step 2: Build mapping (reference → doc_id)
ref_to_id = {}

for r in rows:
    if r["reference"]:
        ref_to_id[r["reference"]] = r["doc_id"]

# Step 3: Create edges using mapping
for r in rows:
    src = r["doc_id"]
    ref = r["reference"]

    if ref and ref in ref_to_id:
        target = ref_to_id[ref]
        G.add_edge(src, target, relation="links_to")

print("Nodes:", len(G.nodes()))
print("Edges:", len(G.edges()))
