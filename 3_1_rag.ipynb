import re

G = nx.DiGraph()

# Add nodes
for r in rows:
    G.add_node(r["doc_id"], content=r["content"])

# Build mapping: title/reference → doc_id
ref_map = {}
for r in rows:
    if r["reference"]:
        ref_map[r["reference"]] = r["doc_id"]

# Extract links from content
for r in rows:
    src = r["doc_id"]
    content = r["content"]

    # Example: [[PageName]]
    links = re.findall(r"\[\[(.*?)\]\]", content)

    for link in links:
        if link in ref_map:
            target = ref_map[link]
            
            if src != target:  # avoid self-loop
                G.add_edge(src, target, relation="links_to")

print("Nodes:", len(G.nodes()))
print("Edges:", len(G.edges()))
