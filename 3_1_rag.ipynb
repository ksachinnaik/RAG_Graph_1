import networkx as nx
import re

G = nx.DiGraph()

# 🔹 Step 1: Create mapping from reference → source
ref_to_source = {}

for r in rows:
    source = r["source"]   # full path
    reference = r["reference"]

    if reference:
        ref_to_source[reference] = source

# 🔹 Step 2: Add nodes
for r in rows:
    G.add_node(r["source"], content=r["content"])

# 🔹 Step 3: Create edges (REAL FIX)
for r in rows:
    src = r["source"]
    ref = r["reference"]

    if ref and ref in ref_to_source:
        target = ref_to_source[ref]

        if src != target:   # avoid self-loop
            G.add_edge(src, target, relation="links_to")

print("Nodes:", len(G.nodes()))
print("Edges:", len(G.edges()))
