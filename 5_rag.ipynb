import re

triples = []

# 🔹 Step 1: Create mapping (reference → source)
ref_to_source = {}

for r in rows:
    if r["reference"]:
        ref_to_source[r["reference"]] = r["source"]

# 🔹 Step 2: Extract links from content
for r in rows:
    src = r["source"]
    content = r["content"]

    # extract links from content
    matches = re.findall(r"doc:(?:wiki:)?([A-Za-z0-9._-]+)", content)

    for m in matches:
        # m = Temp_Import.xxx.WebHome

        if m in ref_to_source:
            target = ref_to_source[m]

            if src != target:
                triples.append((src, "links_to", target))

print("Triples:", triples[:10])
print("Total Triples:", len(triples))
