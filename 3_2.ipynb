def clean_text(text):
    text = re.sub(r"<!\[CDATA\[|\]\]>", "", text)
    text = BeautifulSoup(text, "html.parser").get_text(" ")
    
    # ❌ DO NOT remove [[doc:...]] links
    # only remove macros
    text = re.sub(r"\{\{.*?\}\}", "", text)
    
    return re.sub(r"\s+", " ", text).strip()

# keep rows as list (no need to convert to df again)
for r in rows:
    r["content"] = clean_text(r["content"])

# optional display
display(spark.createDataFrame(rows))
