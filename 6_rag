class GraphRAG:

    def __init__(self, graph, llm):

        self.graph = graph
        self.llm = llm

    def answer(self, query):

        # -----------------------------------
        # Graph Retrieval
        # -----------------------------------

        retrieved_nodes, context = graph_retriever(
            graph=self.graph,
            query=query,
            max_hops=2,
            top_k=5
        )

        # -----------------------------------
        # Display Retrieved Documents
        # -----------------------------------

        print("\n")
        print("=" * 70)
        print("DOCUMENTS SENT TO LLM")
        print("=" * 70)

        for node in retrieved_nodes:

            print(f"Doc ID    : {node}")
            print(f"Title     : {self.graph.nodes[node]['title']}")
            print(f"PageRank  : {self.graph.nodes[node]['pagerank']:.5f}")
            print("-" * 70)

        # -----------------------------------
        # Prompt
        # -----------------------------------

        prompt = f"""
You are an expert assistant.

Answer the user's question ONLY using the retrieved context below.

If the answer is not present in the context, reply:

"I couldn't find the answer in the available XML documents."

Retrieved Context
-----------------

{context}

-----------------

Question:

{query}

Provide a clear and complete answer.
"""

        # -----------------------------------
        # LLM
        # -----------------------------------

        response = self.llm.invoke(prompt)

        return response
