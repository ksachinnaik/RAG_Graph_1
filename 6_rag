def graph_retriever(graph, vector_store, query, max_hops=2, top_k=10):

    # ============================
    # Step 1: Vector search
    # ============================
    docs = vector_store.similarity_search(query, k=top_k)

    start_nodes = [d.metadata["reference"] for d in docs]
    print("Start Nodes:", start_nodes)

    visited = set()
    scores = {}
    path = []

    queue = [(node, 0) for node in start_nodes]

    # ============================
    # Step 2: Initialize scores
    # ============================
    for node in start_nodes:
        if node in graph.nodes():
            scores[node] = graph.nodes[node].get("pagerank", 0)

    # ============================
    # Step 3: Graph traversal
    # ============================
    while queue:
        current, hop = queue.pop(0)

        if hop >= max_hops or current in visited:
            continue

        visited.add(current)
        path.append(current)

        for neighbor in graph.neighbors(current):

            pr = graph.nodes[neighbor].get("pagerank", 0)

            # ✅ Improved scoring (balanced)
            score = (pr * 0.7) + (1 / (hop + 1)) * 0.3

            if neighbor not in scores or score > scores[neighbor]:
                scores[neighbor] = score

            queue.append((neighbor, hop + 1))

    # ============================
    # Step 4: Select top nodes
    # ============================
    ranked = sorted(scores.items(), key=lambda x: x[1], reverse=True)
    top_nodes = [n for n, _ in ranked[:top_k]]

    # ============================
    # Step 5: 🔥 EXPAND GRAPH (IMPORTANT FIX)
    # ============================
    expanded_nodes = set(top_nodes)

    for node in top_nodes:
        neighbors = list(graph.neighbors(node))
        expanded_nodes.update(neighbors)

        # optional 2-hop expansion
        for n1 in neighbors:
            expanded_nodes.update(graph.neighbors(n1))

    final_nodes = list(expanded_nodes)

    print("Final Nodes:", final_nodes)

    return final_nodes, path
