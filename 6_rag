# ==============================
# XML FILE PATHS (Testing)
# ==============================

xml_paths = [
    "/Volumes/...3829c0e9.../WebHome.xml",
    "/Volumes/...76f049ea.../WebHome.xml",
    "/Volumes/...07730902.../WebHome.xml",
    "/Volumes/...f2280f6d.../WebHome.xml",
    "/Volumes/...96bf76a9.../WebHome.xml"
]

rows = []

# ==============================
# READ XML FILES
# ==============================

for path in xml_paths:

    with open(path, "rb") as f:
        soup = BeautifulSoup(f.read(), "xml")

    # Extract XML fields
    content = soup.find("content").text if soup.find("content") else ""

    title = soup.find("title").text if soup.find("title") else None

    xwikidoc = soup.find("xwikidoc")
    reference = xwikidoc.get("reference") if xwikidoc else None

    version = soup.find("version").text if soup.find("version") else None

    update_date = (
        soup.find("contentUpdateDate").text
        if soup.find("contentUpdateDate")
        else None
    )

    author = (
        soup.find("contentAuthor").text.split(".")[-1]
        if soup.find("contentAuthor")
        else None
    )

    rows.append(
        Row(
            content=content,
            source=path,
            title=title,
            reference=reference,
            version=version,
            content_update_date=update_date,
            content_author=author
        )
    )

# ==============================
# CREATE SPARK DATAFRAME
# ==============================

df_raw = spark.createDataFrame(rows)

# Graph Node ID
df_raw = df_raw.withColumn(
    "doc_id",
    monotonically_increasing_id()
)

print(f"Total XML Documents : {df_raw.count()}")

display(df_raw)
