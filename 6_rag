import networkx as nx

# Compute PageRank
pagerank_scores = nx.pagerank(G)

# Store PageRank score in each node
for node_id, score in pagerank_scores.items():

    G.nodes[node_id]["pagerank"] = score

print("=" * 70)
print("PageRank Computed Successfully")
print("=" * 70)

# Sort nodes by PageRank
top_nodes = sorted(
    pagerank_scores.items(),
    key=lambda x: x[1],
    reverse=True
)

print("\nTop Important Documents\n")

for node_id, score in top_nodes:

    node = G.nodes[node_id]

    print(f"Doc ID    : {node_id}")
    print(f"Title     : {node['title']}")
    print(f"Reference : {node['reference']}")
    print(f"PageRank  : {score:.6f}")
    print("-" * 70)
