import os
import xml.etree.ElementTree as ET

# ==========================================================
# XML ROOT FOLDER
# ==========================================================

ROOT_FOLDER = "/Volumes/knwbt_airr_foundry_dev_catalog/secured/vol/Knowledge Bot/Temp_Import/"

# ==========================================================
# TESTING LIMIT
# ==========================================================
# Change this while testing
# 50  -> Read first 50 XMLs
# 100 -> Read first 100 XMLs
# None -> Read ALL XMLs (Production)

MAX_XML_FILES = 50

# ==========================================================
# DISCOVER XML FILES
# ==========================================================

xml_paths = []

for root, dirs, files in os.walk(ROOT_FOLDER):

    if "WebHome.xml" in files:
        xml_paths.append(os.path.join(root, "WebHome.xml"))

xml_paths = sorted(xml_paths)

if MAX_XML_FILES is not None:
    xml_paths = xml_paths[:MAX_XML_FILES]

print("=" * 70)
print("XML DISCOVERY")
print("=" * 70)
print(f"Root Folder      : {ROOT_FOLDER}")
print(f"XML Files Found  : {len(xml_paths)}")
print("=" * 70)

# ==========================================================
# READ XML FILES
# ==========================================================

rows = []

failed_files = []

for idx, path in enumerate(xml_paths):

    try:

        tree = ET.parse(path)
        root = tree.getroot()

        # XML Fields
        content = root.findtext("content") or ""
        title = root.findtext("title") or ""
        version = root.findtext("version")
        update_date = root.findtext("contentUpdateDate")

        author_raw = root.findtext("contentAuthor")
        author = author_raw.split(":")[-1] if author_raw else None

        # Root Attribute
        reference = root.get("reference")

        rows.append(
            Row(
                doc_id=idx,
                source=path,
                title=title,
                reference=reference,
                version=version,
                content_update_date=update_date,
                content_author=author,
                content=content
            )
        )

    except Exception as e:

        failed_files.append((path, str(e)))

# ==========================================================
# CREATE SPARK DATAFRAME
# ==========================================================

df_raw = spark.createDataFrame(rows)

print("\n")
print("=" * 70)
print("XML LOADING SUMMARY")
print("=" * 70)
print(f"Successfully Loaded : {len(rows)}")
print(f"Failed              : {len(failed_files)}")
print("=" * 70)

if failed_files:

    print("\nSample Failed Files\n")

    for path, error in failed_files[:5]:
        print(path)
        print(error)
        print("-" * 60)

display(df_raw)
