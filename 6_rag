import re

# ----------------------------------------------------------
# Normalize extracted references
# ----------------------------------------------------------

def normalize_reference(ref):

    if ref is None:
        return None

    ref = ref.strip()

    # Remove anchor
    if "||" in ref:
        ref = ref.split("||")[0]

    # Remove HTML encoding if present
    ref = ref.replace("&amp;", "&")

    # Remove accidental spaces
    ref = ref.strip()

    return ref


all_links = {}

rows = df_clean.collect()

for row in rows:

    doc_id = row["doc_id"]
    reference = row["reference"]
    content = row["content"]

    links = []

    # ------------------------------------------------------
    # Extract ALL XML references
    # ------------------------------------------------------

    matches = re.findall(

        r"(doc:wiki|doc:Temp_Import|doc):([^[\]\s>]+)",

        content

    )

    # ------------------------------------------------------
    # Convert into relations
    # ------------------------------------------------------

    for link_type, ref in matches:

        ref = normalize_reference(ref)

        if link_type == "doc:wiki":

            relation = "doc:wiki"

        elif link_type == "doc:Temp_Import":

            relation = "doc:Temp_Import"

        else:

            relation = "doc"

        links.append((relation, ref))

    # ------------------------------------------------------
    # Remove duplicate links
    # ------------------------------------------------------

    links = list(set(links))

    all_links[doc_id] = links

    # ------------------------------------------------------
    # Display
    # ------------------------------------------------------

    print("=" * 80)
    print(f"Doc ID      : {doc_id}")
    print(f"Reference   : {reference}")
    print(f"Total Links : {len(links)}")
    print("-" * 80)

    for relation, ref in sorted(links):

        print(f"{relation:<18} --> {ref}")

    print()

# ----------------------------------------------------------
# Summary
# ----------------------------------------------------------

total_links = sum(len(v) for v in all_links.values())

print("=" * 80)
print("LINK EXTRACTION SUMMARY")
print("=" * 80)
print(f"Documents Processed : {len(all_links)}")
print(f"Total Links         : {total_links}")
print("=" * 80)
