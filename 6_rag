# Cell 6 : Extract Links & Create RDF Triples
# ==========================================

import re

triples = []

rows = df_clean.collect()

for row in rows:

    parent_doc_id = row["doc_id"]
    content = row["content"]

    if not content:
        continue

    # Extract doc: and doc:wiki references
    links = re.findall(
        r'doc:(?:wiki:)?(Temp_Import\.[A-Za-z0-9:_\.\-]+?\.WebHome)',
        content
    )

    for reference in links:

        # Check if referenced document exists
        if reference in reference_to_docid:

            child_doc_id = reference_to_docid[reference]

            # Avoid self-loop
            if parent_doc_id != child_doc_id:

                triples.append(
                    (
                        parent_doc_id,
                        "references",
                        child_doc_id
                    )
                )

print(f"Total RDF Triples : {len(triples)}")

print("\nSample RDF Triples\n")

for triple in triples[:10]:
    print(triple)
