def visualize_subgraph(graph, nodes, path=None):

    import matplotlib.pyplot as plt
    import networkx as nx

    # ✅ Step 1: Create subgraph using ONLY relevant nodes
    subgraph = graph.subgraph(nodes)

    plt.figure(figsize=(8, 6))

    pos = nx.spring_layout(subgraph, seed=42)

    # ✅ Step 2: Short labels
    labels = {node: node.split('.')[-2][:6] for node in subgraph.nodes()}

    nx.draw(
        subgraph,
        pos,
        labels=labels,
        node_color="lightblue",
        node_size=2500,
        font_size=8,
        edge_color="gray"
    )

    # ✅ Step 3: Edge labels
    edge_labels = nx.get_edge_attributes(subgraph, 'relation')
    nx.draw_networkx_edge_labels(subgraph, pos, edge_labels=edge_labels, font_size=6)

    # ✅ Step 4: Highlight traversal path (optional)
    if path:

        path_set = set(nodes)
        edges = []

        for u, v in subgraph.edges():
            if u in path_set and v in path_set:
                edges.append((u, v))

        nx.draw_networkx_edges(
            subgraph,
            pos,
            edgelist=edges,
            edge_color="red",
            width=2
        )

        nx.draw_networkx_nodes(
            subgraph,
            pos,
            nodelist=nodes,
            node_color="orange"
        )

    plt.title("Query Relevant Subgraph")
    plt.show()
