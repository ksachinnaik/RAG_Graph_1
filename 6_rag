def visualize_graph(graph, path=None):

    plt.figure(figsize=(10, 7))

    pos = nx.spring_layout(graph, seed=42)

    # Short labels
    labels = {node: node.split('.')[-2][:6] for node in graph.nodes()}

    nx.draw(
        graph,
        pos,
        labels=labels,
        node_color="lightblue",
        node_size=2000,
        font_size=8,
        edge_color="gray"
    )

    # Edge labels
    edge_labels = nx.get_edge_attributes(graph, 'relation')
    nx.draw_networkx_edge_labels(graph, pos, edge_labels=edge_labels, font_size=6)

    # ✅ FIXED: Highlight ONLY valid edges (no straight red line)
    if path:

        path_set = set(path)
        edges = []

        # Only draw edges that actually exist between path nodes
        for u, v in graph.edges():
            if u in path_set and v in path_set:
                edges.append((u, v))

        nx.draw_networkx_edges(
            graph,
            pos,
            edgelist=edges,
            edge_color="red",
            width=2
        )

        nx.draw_networkx_nodes(
            graph,
            pos,
            nodelist=path,
            node_color="orange"
        )

    plt.title("RDF Graph (Traversal Highlighted)")
    plt.show()
