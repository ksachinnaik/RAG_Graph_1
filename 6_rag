# Cell 7 : Convert Links to RDF Triples
# ==========================================================

def find_doc_id(reference):

    if reference is None:
        return None

    reference = reference.strip()

    # ------------------------------------------------------
    # 1. Exact Match
    # ------------------------------------------------------
    if reference in reference_to_docid:
        return reference_to_docid[reference]

    # ------------------------------------------------------
    # 2. Remove Anchor
    # Example:
    # Temp_Import.xxx.WebHome||anchor="abc"
    # ------------------------------------------------------
    ref = reference.split("||")[0]

    if ref in reference_to_docid:
        return reference_to_docid[ref]

    # ------------------------------------------------------
    # 3. Replace ':' with '.'
    # Example:
    # Temp_Import.A:B.WebHome
    # ->
    # Temp_Import.A.B.WebHome
    # ------------------------------------------------------
    ref2 = ref.replace(":", ".")

    if ref2 in reference_to_docid:
        return reference_to_docid[ref2]

    # ------------------------------------------------------
    # 4. Remove duplicate dots
    # ------------------------------------------------------
    while ".." in ref2:
        ref2 = ref2.replace("..", ".")

    if ref2 in reference_to_docid:
        return reference_to_docid[ref2]

    # ------------------------------------------------------
    # Not Found
    # ------------------------------------------------------
    return None


triples = []

matched = 0
missing = 0

for parent_doc_id, links in all_links.items():

    for relation, reference in links:

        # Find destination document
        child_doc_id = find_doc_id(reference)

        # Skip if destination document doesn't exist
        if child_doc_id is None:
            missing += 1
            continue

        matched += 1

        # Avoid self-loops
        if parent_doc_id == child_doc_id:
            continue

        # Create RDF Triple
        triples.append(
            (
                parent_doc_id,
                relation,
                child_doc_id
            )
        )

# ----------------------------------------------------------
# Remove duplicate triples
# ----------------------------------------------------------

triples = list(set(triples))

# ----------------------------------------------------------
# Output
# ----------------------------------------------------------

print("=" * 70)
print("RDF TRIPLES CREATED")
print("=" * 70)

print(f"\nMatched References : {matched}")
print(f"Missing References : {missing}")
print(f"Total RDF Triples  : {len(triples)}")

print("\nSample RDF Triples:\n")

for triple in triples[:10]:
    print(triple)
