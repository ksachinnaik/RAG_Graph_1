# ==========================================
# Cell 10 : Visualize Knowledge Graph
# ==========================================

import matplotlib.pyplot as plt
import networkx as nx

plt.figure(figsize=(12, 8))

# Layout
pos = nx.spring_layout(
    G,
    seed=42,
    k=2.5
)

# -----------------------------
# Draw Nodes
# -----------------------------
nx.draw_networkx_nodes(
    G,
    pos,
    node_size=2500,
    node_color="skyblue"
)

# -----------------------------
# Draw Edges
# -----------------------------
nx.draw_networkx_edges(
    G,
    pos,
    edge_color="gray",
    arrows=True,
    arrowsize=20,
    connectionstyle="arc3,rad=0.08"
)

# -----------------------------
# Node Labels
# -----------------------------
labels = {}

for node in G.nodes():

    labels[node] = f"Doc {node}"

nx.draw_networkx_labels(
    G,
    pos,
    labels=labels,
    font_size=10,
    font_weight="bold"
)

# -----------------------------
# Edge Labels
# -----------------------------
edge_labels = nx.get_edge_attributes(
    G,
    "relation"
)

nx.draw_networkx_edge_labels(
    G,
    pos,
    edge_labels=edge_labels,
    font_size=8
)

plt.title(
    "Graph RAG Knowledge Graph",
    fontsize=18
)

plt.axis("off")
plt.show()

# ==========================================
# Print All Nodes
# ==========================================

print("\n")
print("=" * 80)
print("ALL NODES")
print("=" * 80)

for node, data in G.nodes(data=True):

    print(f"\nDoc ID      : {node}")
    print(f"Title       : {data['title']}")
    print(f"Reference   : {data['reference']}")
    print(f"PageRank    : {data['pagerank']:.6f}")

# ==========================================
# Print All Edges
# ==========================================

print("\n")
print("=" * 80)
print("ALL EDGES")
print("=" * 80)

for source, target, data in G.edges(data=True):

    print(
        f"Doc {source} ----{data['relation']}----> Doc {target}"
    )
