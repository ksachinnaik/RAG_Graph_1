def visualize_subgraph(graph, nodes, path=None):

    import matplotlib.pyplot as plt
    import networkx as nx

    # ✅ Step 1: Expand nodes (add neighbors)
    expanded_nodes = set(nodes)

    for n in nodes:
        neighbors = list(graph.neighbors(n))
        expanded_nodes.update(neighbors)

    # ✅ Step 2: Create subgraph with expanded nodes
    subgraph = graph.subgraph(expanded_nodes)

    plt.figure(figsize=(8, 6))

    pos = nx.spring_layout(subgraph, seed=42)

    # Labels
    labels = {node: node.split('.')[-2][:6] for node in subgraph.nodes()}

    nx.draw(
        subgraph,
        pos,
        labels=labels,
        node_color="lightblue",
        node_size=2000,
        font_size=8,
        edge_color="gray"
    )

    # Edge labels
    edge_labels = nx.get_edge_attributes(subgraph, 'relation')
    nx.draw_networkx_edge_labels(subgraph, pos, edge_labels=edge_labels, font_size=6)

    # Highlight main nodes
    nx.draw_networkx_nodes(
        subgraph,
        pos,
        nodelist=nodes,
        node_color="orange"
    )

    plt.title("Query Relevant Subgraph (with connections)")
    plt.show()
