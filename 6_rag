class GraphRAG:

    def __init__(self, graph, llm):

        self.graph = graph
        self.llm = llm

    def answer(self, query):

        # -----------------------------------
        # Graph Retrieval
        # -----------------------------------

        retrieved_nodes, context = graph_retriever(
            graph=self.graph,
            query=query,
            max_hops=2,
            top_k=5
        )

        # -----------------------------------
        # Create Retrieved Subgraph
        # -----------------------------------

        retrieved_graph = self.graph.subgraph(
            retrieved_nodes
        ).copy()

        # -----------------------------------
        # Prompt
        # -----------------------------------

        prompt = f"""
You are an expert assistant.

Answer ONLY from the provided XML document context.

If the answer is not available in the context, say:

'I couldn't find the answer in the provided XML documents.'

=========================
Context
=========================

{context}

=========================
Question
=========================

{query}

Provide a detailed technical answer.
"""

        # -----------------------------------
        # Azure OpenAI
        # -----------------------------------

        response = self.llm.invoke(prompt)

        # -----------------------------------
        # Return Everything
        # -----------------------------------

        return {

            "query": query,

            "answer": response.content,

            "retrieved_nodes": retrieved_nodes,

            "retrieved_graph": retrieved_graph,

            "context": context

        }
