for parent_doc_id, links in all_links.items():

    for relation, reference in links:

        child_doc_id = reference_to_docid.get(reference)

        if child_doc_id is None:

            missing += 1

            if len(missing_refs) < 100:
                missing_refs.append(
                    (
                        parent_doc_id,
                        relation,
                        reference
                    )
                )

        else:

            matched += 1


print(f"Total Extracted Links     : {matched + missing}")
