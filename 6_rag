# ==========================================
# Cell 6 : Extract ALL doc/doc:wiki Links
# ==========================================

import re

all_links = {}

rows = df_clean.collect()

for row in rows:

    doc_id = row["doc_id"]
    reference = row["reference"]
    content = row["content"]

    # Extract every doc: or doc:wiki reference
    links = re.findall(
        r'doc:(?:wiki:)?([^\]\s>]+)',
        content
    )

    # Remove duplicates
    links = list(set(links))

    all_links[doc_id] = links

    print("=" * 80)
    print(f"Doc ID      : {doc_id}")
    print(f"Reference   : {reference}")
    print(f"Total Links : {len(links)}")

    for link in links:
        print("  -->", link)

    print()
