# 🔹 Step 2: build RDF triples
for r in rows:
    parent = r["reference"]   # 🔥 Parent node
    content = r["content"]

    if not parent:
        continue

    # 🔥 Extract BOTH:
    # doc:wiki:Temp_Import.xxx.WebHome
    # doc:Temp_Import.xxx.WebHome
    links = re.findall(r"doc:(?:wiki:)?([A-Za-z0-9._-]+)", content)

    for child in links:
