# ==========================================
# Cell 6 : Extract ALL doc/doc:wiki Links
# ==========================================

import re

all_links = {}

rows = df_clean.collect()

for row in rows:

    doc_id = row["doc_id"]
    reference = row["reference"]
    content = row["content"]

    links = []

    # --------------------------------------
    # Extract doc:wiki links
    # --------------------------------------

    wiki_links = re.findall(
        r"doc:wiki:([^\]\s>]+)",
        content
    )

    for ref in wiki_links:
        links.append(("doc:wiki", ref))

    # --------------------------------------
    # Extract normal doc links
    # (Exclude doc:wiki)
    # --------------------------------------

    doc_links = re.findall(
        r"(?<!doc:wiki:)doc:([^\]\s>]+)",
        content
    )

    for ref in doc_links:

        # Skip if already extracted as doc:wiki
        if ("doc:wiki", ref) not in links:
            links.append(("doc", ref))

    # --------------------------------------
    # Remove duplicates
    # --------------------------------------

    links = list(set(links))

    all_links[doc_id] = links

    # --------------------------------------
    # Display
    # --------------------------------------

    print("=" * 80)
    print(f"Doc ID      : {doc_id}")
    print(f"Reference   : {reference}")
    print(f"Total Links : {len(links)}")

    for relation, ref in links:
        print(f"  --> {relation:<8} : {ref}")

    print()
