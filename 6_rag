# ==========================================
# Graph Visualization Function
# ==========================================

import matplotlib.pyplot as plt
import networkx as nx

def visualize_graph(graph):

    plt.figure(figsize=(15,10))

    pos = nx.spring_layout(
        graph,
        seed=42,
        k=2,
        iterations=300
    )

    # Draw Nodes
    nx.draw_networkx_nodes(
        graph,
        pos,
        node_size=3500,
        node_color="skyblue",
        edgecolors="black",
        linewidths=2
    )

    # Draw Edges
    nx.draw_networkx_edges(
        graph,
        pos,
        arrows=True,
        arrowstyle="-|>",
        arrowsize=30,
        width=2,
        edge_color="black",
        connectionstyle="arc3,rad=0.08"
    )

    # Node Labels (doc_id + title)
    labels = {}

    for node in graph.nodes():

        title = graph.nodes[node]["title"]

        if len(title) > 25:
            title = title[:25] + "..."

        labels[node] = f"{node}\n{title}"

    nx.draw_networkx_labels(
        graph,
        pos,
        labels,
        font_size=9,
        font_weight="bold"
    )

    plt.title(
        "Retrieved Graph RAG Subgraph",
        fontsize=16,
        fontweight="bold"
    )

    plt.axis("off")

    plt.tight_layout()

    plt.show()
