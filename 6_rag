# ==========================================================
# Cell 7C : Verify Missing References (100 Sample)
# ==========================================================

print("=" * 90)
print("VERIFYING MISSING REFERENCES")
print("=" * 90)

checked = 0
found = 0
not_found = 0

found_refs = []
missing_refs = []

for parent_doc, links in all_links.items():

    for relation, ref in links:

        # Skip references already mapped
        if ref in reference_to_docid:
            continue

        checked += 1

        exists = df_clean.filter(df_clean.reference == ref).count()

        if exists > 0:
            found += 1
            found_refs.append((parent_doc, relation, ref))
        else:
            not_found += 1
            missing_refs.append((parent_doc, relation, ref))

        # Check only first 100 missing references
        if checked >= 100:
            break

    if checked >= 100:
        break


print("\n")
print("=" * 90)
print("SUMMARY")
print("=" * 90)

print(f"Checked References : {checked}")
print(f"Found in XMLs      : {found}")
print(f"Not Found          : {not_found}")

if checked > 0:
    print(f"Found %            : {(found/checked)*100:.2f}%")
    print(f"Missing %          : {(not_found/checked)*100:.2f}%")

print("\n")

print("=" * 90)
print("FIRST 20 FOUND REFERENCES")
print("=" * 90)

for parent_doc, relation, ref in found_refs[:20]:

    print(f"Parent Doc : {parent_doc}")
    print(f"Relation   : {relation}")
    print(f"Reference  : {ref}")
    print("-" * 80)


print("\n")

print("=" * 90)
print("FIRST 20 MISSING REFERENCES")
print("=" * 90)

for parent_doc, relation, ref in missing_refs[:20]:

    print(f"Parent Doc : {parent_doc}")
    print(f"Relation   : {relation}")
    print(f"Reference  : {ref}")
    print("-" * 80)
