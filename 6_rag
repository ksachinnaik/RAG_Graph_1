import xml.etree.ElementTree as ET
from pyspark.sql import Row

# ==========================================
# XML FILE PATHS (Testing - 5 XML Files)
# ==========================================

xml_paths = [
    "/Volumes/knwbt_airr_foundry_dev_catalog/secured/vol/Knowledge Bot/Temp_Import/3829c0e9-2342-11f1-8720-005056902ed8/WebHome.xml",
    "/Volumes/knwbt_airr_foundry_dev_catalog/secured/vol/Knowledge Bot/Temp_Import/76f049ea-230a-11f1-8720-005056902ed8/WebHome.xml",
    "/Volumes/knwbt_airr_foundry_dev_catalog/secured/vol/Knowledge Bot/Temp_Import/0773d902-2304-11f1-8720-005056902ed8/WebHome.xml",
    "/Volumes/knwbt_airr_foundry_dev_catalog/secured/vol/Knowledge Bot/Temp_Import/f2280f6d-230b-11f1-8720-005056902ed8/WebHome.xml",
    "/Volumes/knwbt_airr_foundry_dev_catalog/secured/vol/Knowledge Bot/Temp_Import/96bf76a9-234d-11f1-8720-005056902ed8/WebHome.xml"
]

rows = []

# ==========================================
# READ XML FILES
# ==========================================

for idx, path in enumerate(xml_paths):

    tree = ET.parse(path)
    root = tree.getroot()

    # XML Fields
    content = root.findtext("content") or ""
    title = root.findtext("title")
    version = root.findtext("version")
    update_date = root.findtext("contentUpdateDate")

    author_raw = root.findtext("contentAuthor")
    author = author_raw.split(".")[-1] if author_raw else None

    # Root attribute
    reference = root.get("reference")

    rows.append(
        Row(
            doc_id=idx,
            source=path,
            title=title,
            reference=reference,
            version=version,
            content_update_date=update_date,
            content_author=author,
            content=content
        )
    )

# ==========================================
# CREATE SPARK DATAFRAME
# ==========================================

df_raw = spark.createDataFrame(rows)

print(f"Total XML Documents : {df_raw.count()}")

display(df_raw)
