# ==========================================================
# Cell 5 : Reference -> Doc_ID Mapping
# ==========================================================

reference_to_docid = {}

duplicate_count = 0

# ==========================================
# Build Mapping
# ==========================================

for row in df_clean.toLocalIterator():

    reference = row["reference"]
    doc_id = row["doc_id"]

    if reference and reference.strip():

        if reference in reference_to_docid:
            duplicate_count += 1
            print(f"Duplicate Reference Found : {reference}")

        reference_to_docid[reference] = doc_id


# ==========================================
# Summary
# ==========================================

print("=" * 80)
print("REFERENCE  --->  DOC_ID MAPPING")
print("=" * 80)

print(f"\nTotal XML Documents  : {df_clean.count()}")
print(f"Unique References    : {len(reference_to_docid)}")
print(f"Duplicate References : {duplicate_count}")

print("\nComplete Reference Mapping:\n")


# ==========================================
# Display All Mappings (Testing)
# ==========================================

for reference, doc_id in reference_to_docid.items():

    print(f"Doc ID     : {doc_id}")
    print(f"Reference  : {reference}")
    print("-" * 80)
