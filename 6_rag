def visualize_graph(graph, path=None, top_n=25):

    import matplotlib.pyplot as plt
    import networkx as nx

    plt.figure(figsize=(12, 9))

    # ✅ Step 1: Select top important nodes (reduce clutter)
    pagerank = nx.pagerank(graph)
    top_nodes = sorted(pagerank, key=pagerank.get, reverse=True)[:top_n]

    subgraph = graph.subgraph(top_nodes)

    pos = nx.spring_layout(subgraph, seed=42, k=0.5)

    # ✅ Step 2: Node sizes based on importance
    sizes = [pagerank[n] * 20000 for n in subgraph.nodes()]

    # ✅ Step 3: Short readable labels
    labels = {}
    for node in subgraph.nodes():
        short = node.split('.')[-2] if '.' in node else node
        labels[node] = short[:8]

    # ✅ Step 4: Draw base graph
    nx.draw(
        subgraph,
        pos,
        labels=labels,
        node_size=sizes,
        node_color="skyblue",
        font_size=8,
        edge_color="gray",
        alpha=0.7
    )

    # ✅ Step 5: Highlight traversal path (CORRECT WAY)
    if path:
        path_edges = []

        for i in range(len(path)-1):
            if subgraph.has_edge(path[i], path[i+1]):
                path_edges.append((path[i], path[i+1]))

        nx.draw_networkx_edges(
            subgraph,
            pos,
            edgelist=path_edges,
            edge_color="red",
            width=3
        )

        nx.draw_networkx_nodes(
            subgraph,
            pos,
            nodelist=[n for n in path if n in subgraph.nodes()],
            node_color="orange"
        )

    # ✅ Step 6: Clean title
    plt.title("GraphRAG Visualization (Top Nodes + Traversal Path)")
    plt.show()
