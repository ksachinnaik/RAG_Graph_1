# Cell 5: RDF Triple Extraction
# ============================

import re

triples = []

# Step 1: Loop through each XML (parent)
for r in rows:

    parent = r["reference"]   # ✅ Parent node
    content = r["content"]

    if not parent:
        continue

    # Step 2: Extract child links from content
    links = re.findall(r"doc:(?:wiki:)?([A-Za-z0-9._-]+)", content)

    # Step 3: Create edges (parent → child)
    for child in links:

        if parent != child:   # avoid self-loop
            triples.append((parent, "links_to", child))


# Step 4: Build ALL nodes (parents + children)
all_nodes = set()

for s, p, o in triples:
    all_nodes.add(s)
    all_nodes.add(o)

# Step 5: Print results
print("Total Parent Nodes:", len(set([r["reference"] for r in rows if r["reference"]])))
print("Total Graph Nodes:", len(all_nodes))
print("Total Triples (Edges):", len(triples))

print("\nSample Triples:")
for t in triples[:10]:
    print(t)
