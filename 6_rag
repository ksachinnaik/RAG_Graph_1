retrieved_graph = result["retrieved_graph"]

# -----------------------------------------------------
# Build connected subgraph
# -----------------------------------------------------

if retrieved_graph.number_of_edges() > 0:

    connected_nodes = set()

    for u, v in retrieved_graph.edges():
        connected_nodes.add(u)
        connected_nodes.add(v)

    connected_subgraph = retrieved_graph.subgraph(
        connected_nodes
    ).copy()

else:
    # If only one document is retrieved, keep it
    connected_subgraph = retrieved_graph.copy()

# -----------------------------------------------------
# Graph Statistics
# -----------------------------------------------------

print(f"\nRetrieved Nodes : {connected_subgraph.number_of_nodes()}")
print(f"Retrieved Edges : {connected_subgraph.number_of_edges()}")

