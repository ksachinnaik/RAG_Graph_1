# Cell 11 : Graph Retriever
# ==========================================

import re
from collections import deque


def graph_retriever(graph, query, max_hops=2, top_k=5):

    # -----------------------------
    # Step 1 : Query Keywords
    # -----------------------------

    query_words = set(re.findall(r"\w+", query.lower()))

    candidate_nodes = []

    # -----------------------------
    # Step 2 : Find Relevant Documents
    # -----------------------------

    for node, data in graph.nodes(data=True):

        searchable_text = (
            data["title"] + " " + data["content"]
        ).lower()

        words = set(re.findall(r"\w+", searchable_text))

        overlap = len(query_words & words)

        if overlap > 0:

            candidate_nodes.append(
                (
                    node,
                    overlap
                )
            )

    if len(candidate_nodes) == 0:

        print("No relevant document found.")
        return [], ""

    # -----------------------------
    # Step 3 : Rank Initial Nodes
    # -----------------------------

    candidate_nodes.sort(
        key=lambda x: (
            x[1],
            graph.nodes[x[0]]["pagerank"]
        ),
        reverse=True
    )

    start_nodes = [
        node
        for node, score in candidate_nodes[:top_k]
    ]

    print("=" * 60)
    print("START DOCUMENTS")
    print("=" * 60)

    for node in start_nodes:

        print(f"{node} : {graph.nodes[node]['title']}")

    # -----------------------------
    # Step 4 : Multi-Hop Traversal
    # -----------------------------

    visited = set()

    queue = deque()

    for node in start_nodes:

        queue.append((node, 0))

    retrieved = {}

    while queue:

        current, hop = queue.popleft()

        if current in visited:
            continue

        if hop > max_hops:
            continue

        visited.add(current)

        # Score combines:
        #
        # PageRank
        # Hop Distance

        score = (
            graph.nodes[current]["pagerank"]
            /
            (hop + 1)
        )

        retrieved[current] = max(
            score,
            retrieved.get(current, 0)
        )

        # Outgoing References

        for neighbor in graph.successors(current):

            queue.append(
                (
                    neighbor,
                    hop + 1
                )
            )

        # Incoming References

        for neighbor in graph.predecessors(current):

            queue.append(
                (
                    neighbor,
                    hop + 1
                )
            )

    # -----------------------------
    # Step 5 : Final Ranking
    # -----------------------------

    ranked = sorted(

        retrieved.items(),

        key=lambda x: x[1],

        reverse=True

    )

    top_nodes = [

        node

        for node, score in ranked[:top_k]

    ]

    print("\n")

    print("=" * 60)
    print("RETRIEVED DOCUMENTS")
    print("=" * 60)

    context = ""

    for node in top_nodes:

        print(f"{node} : {graph.nodes[node]['title']}")

        context += "\n\n"

        context += f"Document ID : {node}\n"

        context += f"Title : {graph.nodes[node]['title']}\n"

        context += graph.nodes[node]["content"]

    return top_nodes, context
