# Cell 7 : Convert Links to RDF Triples
# ==========================================

triples = []

for parent_doc_id, links in all_links.items():

    for reference in links:

        # Find the destination document
        child_doc_id = reference_to_docid.get(reference)

        # Create edge only if destination exists
        if child_doc_id is not None:

            # Avoid self-loops
            if parent_doc_id != child_doc_id:

                triples.append(
                    (
                        parent_doc_id,
                        "references",
                        child_doc_id
                    )
                )

# Remove duplicate triples
triples = list(set(triples))

print("=" * 60)
print("RDF Triples Created Successfully")
print("=" * 60)

print(f"Total RDF Triples : {len(triples)}")

print("\nSample RDF Triples:\n")

for triple in triples[:10]:
    print(triple)
