import re
from pyspark.sql import Row

# ==========================================
# CLEAN XML CONTENT
# ==========================================

def clean_text(text):

    if text is None:
        return ""

    # Remove CDATA markers
    text = re.sub(r"<!\[CDATA\[|\]\]>", "", text)

    # Normalize whitespace
    text = re.sub(r"\s+", " ", text).strip()

    return text


