# Cell 7B : Verify Missing References
# ==========================================================

print("=" * 90)
print("VERIFYING MISSING REFERENCES")
print("=" * 90)

loaded_references = set(reference_to_docid.keys())

checked = 0

for parent_doc_id, links in all_links.items():

    for relation, reference in links:

        child_doc_id = reference_to_docid.get(reference)

        if child_doc_id is None:

            print(f"\nParent Doc ID : {parent_doc_id}")
            print(f"Relation      : {relation}")
            print(f"Reference     : {reference}")

            if reference in loaded_references:
                print("Status        : FOUND")
            else:
                print("Status        : NOT FOUND")

                # Try to find similar references
                similar = []

                for ref in loaded_references:

                    if reference.split(".")[0] == ref.split(".")[0]:
                        similar.append(ref)

                    if len(similar) >= 5:
                        break

                if similar:
                    print("\nClosest Loaded References:")

                    for s in similar:
                        print("   ", s)

            print("-" * 90)

            checked += 1

            if checked >= 20:
                break

    if checked >= 20:
        break

print("\nFinished Checking.")
