import matplotlib.pyplot as plt
import networkx as nx

plt.figure(figsize=(16,12))

# Better layout
pos = nx.kamada_kawai_layout(G)

# -------------------------
# Draw Nodes
# -------------------------

nx.draw_networkx_nodes(
    G,
    pos,
    node_size=4200,
    node_color="#A8D8F0",
    edgecolors="black",
    linewidths=2
)

# -------------------------
# Draw Edges
# -------------------------

nx.draw_networkx_edges(
    G,
    pos,
    arrows=True,
    arrowstyle="-|>",
    arrowsize=35,
    width=2.5,
    edge_color="black",
    connectionstyle="arc3,rad=0.08",
    min_source_margin=25,
    min_target_margin=25
)

# -------------------------
# Node Labels
# -------------------------

labels = {}

for node in G.nodes():

    title = G.nodes[node]["title"]

    # Short title
    if len(title) > 28:
        title = title[:28] + "..."

    labels[node] = f"{node}\n{title}"

nx.draw_networkx_labels(
    G,
    pos,
    labels,
    font_size=9,
    font_weight="bold"
)

plt.title(
    "Graph RAG Knowledge Graph",
    fontsize=18,
    fontweight="bold"
)

plt.axis("off")

plt.tight_layout()

plt.show()
