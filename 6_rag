import re
from pyspark.sql import Row

def clean_text(text):

    if text is None:
        return ""

    # Remove CDATA markers only
    text = re.sub(r"<!\[CDATA\[|\]\]>", "", text)

    # Normalize whitespace
    text = re.sub(r"\s+", " ", text).strip()

    return text


