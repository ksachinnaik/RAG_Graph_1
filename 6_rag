# ==========================================
# Cell 5 : Reference -> doc_id Mapping
# ==========================================

reference_to_docid = {}

rows = df_clean.collect()

for row in rows:

    reference = row["reference"]
    doc_id = row["doc_id"]

    if reference and reference.strip():

        if reference in reference_to_docid:
            print(f"Duplicate reference found: {reference}")

        reference_to_docid[reference] = doc_id

print("=" * 60)
print("REFERENCE → DOC_ID MAPPING")
print("=" * 60)

print(f"\nTotal Documents : {len(reference_to_docid)}")

print("\nSample Mapping:\n")

count = 0

for ref, doc in reference_to_docid.items():

    print(f"Doc ID    : {doc}")
    print(f"Reference : {ref}")
    print("-" * 60)

    count += 1

    if count == 5:
        break
