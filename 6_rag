class GraphRAG:

    def __init__(self, graph, vector_store, llm):
        self.graph = graph
        self.vector_store = vector_store
        self.llm = llm

    def answer(self, query):

        # Step 1: Retrieve nodes
        nodes, path = graph_retriever(
            self.graph,
            self.vector_store,
            query
        )

        # Step 2: Visualize (safe)
        if path:
            visualize_graph(self.graph, path)

        # Step 3: Build context
        context = ""

        for n in nodes:
            content = self.graph.nodes[n].get("content", "")
            if content:
                context += "\n" + content

        # Step 4: Prompt
        prompt = f"""
Answer the question using the context below.

Context:
{context}

Question:
{query}
"""

        # Step 5: LLM response
        response = self.llm.invoke(prompt)

        return response.content
