# Cell 5 : Create Reference → doc_id Mapping
# ==========================================

reference_to_docid = {}

rows = df_clean.collect()

for row in rows:

    doc_id = row["doc_id"]
    reference = row["reference"]

    if reference:
        reference_to_docid[reference] = doc_id

print(f"Total References : {len(reference_to_docid)}")

print("\nSample Mapping:\n")

for i, (ref, doc) in enumerate(reference_to_docid.items()):

    print(f"{doc}  --->  {ref}")

    if i == 4:
        break
