import networkx as nx

print("=" * 80)
print("GRAPH ANALYTICS")
print("=" * 80)

# ==========================================================
# Compute Graph Metrics
# ==========================================================

pagerank_scores = nx.pagerank(G)

degree_scores = dict(G.degree())

in_degree_scores = dict(G.in_degree())

out_degree_scores = dict(G.out_degree())

betweenness_scores = nx.betweenness_centrality(G)

closeness_scores = nx.closeness_centrality(G)

# ==========================================================
# Store Analytics inside Graph Nodes
# ==========================================================

for node in G.nodes():

    G.nodes[node]["pagerank"] = pagerank_scores.get(node, 0.0)

    G.nodes[node]["degree"] = degree_scores.get(node, 0)

    G.nodes[node]["in_degree"] = in_degree_scores.get(node, 0)

    G.nodes[node]["out_degree"] = out_degree_scores.get(node, 0)

    G.nodes[node]["betweenness"] = betweenness_scores.get(node, 0.0)

    G.nodes[node]["closeness"] = closeness_scores.get(node, 0.0)

    # Search text for retrieval
    title = G.nodes[node].get("title", "")
    content = G.nodes[node].get("content", "")

    G.nodes[node]["search_text"] = (
        title + "\n" + content
    )

print("\nAnalytics stored successfully.\n")

# ==========================================================
# Top PageRank Documents
# ==========================================================

print("=" * 80)
print("TOP 10 IMPORTANT DOCUMENTS")
print("=" * 80)

top_nodes = sorted(
    pagerank_scores.items(),
    key=lambda x: x[1],
    reverse=True
)

for node_id, score in top_nodes[:10]:

    node = G.nodes[node_id]

    print(f"Doc ID         : {node_id}")
    print(f"Title          : {node['title']}")
    print(f"Reference      : {node['reference']}")
    print(f"PageRank       : {score:.6f}")
    print(f"Degree         : {node['degree']}")
    print(f"In Degree      : {node['in_degree']}")
    print(f"Out Degree     : {node['out_degree']}")
    print(f"Betweenness    : {node['betweenness']:.6f}")
    print(f"Closeness      : {node['closeness']:.6f}")
    print("-" * 80)

