# ==========================================================
# Cell 5 : Reference -> Doc_ID Mapping
# ==========================================================

reference_to_docid = {}

duplicate_count = 0
duplicate_references = []

for row in df_clean.toLocalIterator():

    reference = row["reference"]
    doc_id = row["doc_id"]

    if not reference:
        continue

    reference = reference.strip()

    # ------------------------------------------------------
    # Build all possible aliases for this reference
    # ------------------------------------------------------

    aliases = set()

    # Original reference
    aliases.add(reference)

    # Remove anchor if present
    aliases.add(reference.split("||")[0])

    # Remove fragment (#...)
    aliases.add(reference.split("#")[0])

    # Remove trailing spaces
    aliases = {a.strip() for a in aliases if a.strip()}

    # ------------------------------------------------------
    # Store aliases
    # ------------------------------------------------------

    for alias in aliases:

        if alias in reference_to_docid:

            duplicate_count += 1
            duplicate_references.append(alias)

        reference_to_docid[alias] = doc_id


# ==========================================================
# Summary
# ==========================================================

print("=" * 80)
print("REFERENCE -> DOC_ID MAPPING")
print("=" * 80)

print(f"Total XML Documents : {df_clean.count()}")
print(f"Unique References   : {len(reference_to_docid)}")
print(f"Duplicate References: {duplicate_count}")

print("=" * 80)

# ==========================================================
# Sample Mapping
# ==========================================================

print("\nSample Mapping\n")

for i, (ref, doc) in enumerate(reference_to_docid.items()):

    print(f"Doc ID    : {doc}")
    print(f"Reference : {ref}")
    print("-" * 80)

    if i == 9:
        break


# ==========================================================
# Duplicate Summary
# ==========================================================

if duplicate_references:

    print("\nDuplicate References (First 10)\n")

    for ref in duplicate_references[:10]:
        print(ref)
