print("=" * 80)
print("RDF MATCH DEBUG")
print("=" * 80)

matched_examples = []
missing_examples = []

for parent_doc_id, links in all_links.items():

    for relation, reference in links:

        child = resolve_reference(reference)

        if child is None:

            if len(missing_examples) < 20:
                missing_examples.append(
                    (parent_doc_id, relation, reference)
                )

        else:

            if len(matched_examples) < 20:
                matched_examples.append(
                    (
                        parent_doc_id,
                        relation,
                        reference,
                        child
                    )
                )

print("\nFIRST 20 MATCHED\n")

for parent, relation, ref, child in matched_examples:

    print(f"Parent   : {parent}")
    print(f"Relation : {relation}")
    print(f"Ref      : {repr(ref)}")
    print(f"Child ID : {child}")
    print("-" * 80)

print("\n")
print("=" * 80)

print("\nFIRST 20 MISSING\n")

for parent, relation, ref in missing_examples:

    print(f"Parent   : {parent}")
    print(f"Relation : {relation}")
    print(f"Ref      : {repr(ref)}")

    # Show similar loaded references
    similar = [
        r for r in reference_to_docid.keys()
        if ref[:20] in r
    ]

    if similar:
        print("Similar Loaded References:")

        for s in similar[:5]:
            print("   ", repr(s))
    else:
        print("No Similar Reference Found")

    print("-" * 80)
