import re

reference_to_docid = {}

duplicate_count = 0
duplicate_references = []


# ==========================================================
# Normalize Reference
# ==========================================================

def generate_reference_aliases(reference):

    aliases = set()

    if not reference:
        return aliases

    reference = reference.strip()

    # Original
    aliases.add(reference)

    # Remove anchor
    aliases.add(reference.split("||")[0])

    # Remove section
    aliases.add(reference.split("#")[0])

    # ------------------------------------------------------
    # Generate aliases from every existing alias
    # ------------------------------------------------------

    expanded = set()

    for alias in aliases:

        alias = alias.strip()

        expanded.add(alias)

        # Remove anchor again (safe)
        expanded.add(alias.split("||")[0])

        # Remove fragment
        expanded.add(alias.split("#")[0])

        # Remove trailing slash
        expanded.add(alias.rstrip("/"))

        # Remove trailing spaces
        expanded.add(alias.strip())

        # Lowercase version (optional lookup)
        expanded.add(alias.lower())

        # Uppercase version (optional lookup)
        expanded.add(alias.upper())

    return {a for a in expanded if a}


# ==========================================================
# Build Dictionary
# ==========================================================

for row in df_clean.toLocalIterator():

    doc_id = row["doc_id"]
    reference = row["reference"]

    aliases = generate_reference_aliases(reference)

    for alias in aliases:

        if alias in reference_to_docid:

            duplicate_count += 1
            duplicate_references.append(alias)

        reference_to_docid[alias] = doc_id


