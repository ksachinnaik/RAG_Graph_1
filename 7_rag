import re

# ==========================================================
# Normalize Extracted References
# ==========================================================

def normalize_reference(ref):

    if not ref:
        return None

    ref = ref.strip()

    # Remove anchor
    ref = ref.split("||")[0]

    # Remove fragment
    ref = ref.split("#")[0]

    # Decode HTML entities
    ref = ref.replace("&amp;", "&")

    # Remove accidental spaces
    ref = re.sub(r"\s+", " ", ref).strip()

    return ref


# ==========================================================
# Extract Relation Type
# ==========================================================

def extract_relation(raw_link):

    if raw_link.startswith("doc:wiki:"):
        return "doc:wiki", raw_link[len("doc:wiki:"):]

    elif raw_link.startswith("doc:Temp_Import:"):
        return "doc:Temp_Import", raw_link[len("doc:Temp_Import:"):]

    elif raw_link.startswith("doc:"):
        return "doc", raw_link[len("doc:"):]

    return None, None


# ==========================================================
# Extract All Links
# ==========================================================

all_links = {}

for row in df_clean.toLocalIterator():

    doc_id = row["doc_id"]
    reference = row["reference"]
    content = row["content"] or ""

    links = []

    # ------------------------------------------------------
    # Extract EVERYTHING inside [[...]]
    # ------------------------------------------------------

    raw_links = re.findall(r"\[\[(.*?)\]\]", content)

    for raw_link in raw_links:

        relation, ref = extract_relation(raw_link)

        if relation is None:
            continue

        ref = normalize_reference(ref)

        if not ref:
            continue

        links.append((relation, ref))

    # ------------------------------------------------------
    # Remove duplicate links
    # ------------------------------------------------------

    links = sorted(set(links))

    all_links[doc_id] = links

    # ------------------------------------------------------
    # Display
    # ------------------------------------------------------

    print("=" * 80)
    print(f"Doc ID      : {doc_id}")
    print(f"Reference   : {reference}")
    print(f"Total Links : {len(links)}")
    print("-" * 80)

    for relation, ref in links:
        print(f"{relation:<18} --> {ref}")

    print()

